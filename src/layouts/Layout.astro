---
import '../styles/global.css';
import { person, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c3326" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <script is:inline>
      try {
        var t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--board)]">
      <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-5 py-3">
        <a href="#inicio" class="flex items-center gap-3 no-underline" aria-label="Renzo Campisi, ir al inicio">
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <g fill="var(--pin)">
              <rect x="0" y="8" width="5" height="3" /><rect x="0" y="15" width="5" height="3" /><rect x="0" y="22" width="5" height="3" />
              <rect x="29" y="8" width="5" height="3" /><rect x="29" y="15" width="5" height="3" /><rect x="29" y="22" width="5" height="3" />
            </g>
            <rect x="5" y="3" width="24" height="28" rx="3" fill="var(--ic-body)" />
            <circle cx="9.5" cy="7.5" r="1.3" fill="var(--ic-dim)" />
            <text x="17" y="22.5" text-anchor="middle" font-family="Big Shoulders Display" font-weight="800" font-size="13" fill="var(--copper)">RC</text>
          </svg>
          <span class="font-display text-xl font-extrabold uppercase leading-none tracking-wide">Renzo Campisi</span>
        </a>

        <nav aria-label="Principal" class="hidden md:block">
          <ul class="m-0 flex list-none items-center gap-1 p-0">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={n.href}
                    data-nav
                    class="block rounded px-3 py-2 text-[0.95rem] font-semibold no-underline decoration-[var(--copper-ink)] decoration-2 underline-offset-[0.5em] hover:underline aria-[current=true]:underline"
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <button type="button" id="tema" class="switch" role="switch" aria-checked="false" aria-label="Modo claro">
            <span class="lever"></span>
          </button>
          <button
            type="button"
            id="menu-btn"
            class="btn btn-line !min-h-11 !px-3 md:!hidden"
            aria-expanded="false"
            aria-controls="menu-movil"
          >
            Menú
          </button>
        </div>
      </div>
      <nav id="menu-movil" aria-label="Principal móvil" class="hidden border-t border-[var(--line)] md:!hidden">
        <ul class="m-0 list-none px-5 py-2">
          {
            nav.map((n) => (
              <li>
                <a href={n.href} data-nav class="block py-3 text-lg font-semibold no-underline aria-[current=true]:text-[var(--copper-ink)]">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="contenido" class="board">
      <div class="bus" aria-hidden="true" id="bus"></div>
      <slot />
    </main>

    <footer class="border-t border-[var(--line)]">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-3 px-5 py-8 text-[0.95rem] text-[var(--ink-dim)]">
        <p class="m-0">© 2026 {person.name}.</p>
        <a href="#inicio" class="font-semibold">Volver arriba</a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Tema claro / oscuro
      const sw = document.getElementById('tema') as HTMLButtonElement;
      const prefersLight = () => window.matchMedia('(prefers-color-scheme: light)').matches;
      const isLight = () =>
        root.dataset.theme ? root.dataset.theme === 'light' : prefersLight();
      const syncSwitch = () => {
        sw.setAttribute('aria-checked', String(isLight()));
        sw.setAttribute('aria-label', isLight() ? 'Modo claro activado, cambiar a oscuro' : 'Modo oscuro activado, cambiar a claro');
      };
      syncSwitch();
      sw.addEventListener('click', () => {
        const next = isLight() ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('tema', next);
        } catch (e) {}
        syncSwitch();
      });

      // Menú móvil
      const btn = document.getElementById('menu-btn') as HTMLButtonElement;
      const menu = document.getElementById('menu-movil') as HTMLElement;
      const setMenu = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('hidden', !open);
      };
      btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          btn.focus();
        }
      });

      // La pista de cobre avanza con el scroll y enciende los pads de cada sección
      const bus = document.getElementById('bus') as HTMLElement;
      const main = document.getElementById('contenido') as HTMLElement;
      const pads = Array.from(document.querySelectorAll<HTMLElement>('.pad'));
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
      const sections = pads.map((p) => p.closest('section') as HTMLElement);

      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = main.getBoundingClientRect();
        const probe = window.innerHeight * 0.55;
        const progress = Math.min(1, Math.max(0, (probe - rect.top) / rect.height));
        bus.style.setProperty('--p', reduce ? '1' : progress.toFixed(4));
        let current = 0;
        sections.forEach((s, i) => {
          const lit = reduce || s.getBoundingClientRect().top < probe;
          pads[i].dataset.lit = String(lit);
          if (s.getBoundingClientRect().top < window.innerHeight * 0.4) current = i;
        });
        links.forEach((l) => {
          const on = l.getAttribute('href') === '#' + sections[current].id;
          l.setAttribute('aria-current', String(on));
        });
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    </script>
  </body>
</html>
