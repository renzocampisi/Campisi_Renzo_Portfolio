---
import Avatar from './Avatar.astro';
import { person } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pines y pistas de un lado del chip; el resto sale de rotar este mismo lado
const pins = Array.from({ length: 9 }, (_, i) => {
  const y = 156 + i * 21;
  const d = (i - 4) * 14;
  const ax = 100;
  const path = `M118 ${y} H${ax} L${ax - Math.abs(d)} ${y + d} H0`;
  return { y, path, live: i % 3 === 1 };
});
const sides = [0, 90, 180, 270];
---

<section id="inicio" class="section !pt-10 md:!pt-14" aria-labelledby="titulo-inicio">
  <span class="pad" style="top: 3.2rem" data-lit="true"></span>

  <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h1
        id="titulo-inicio"
        class="hero-in m-0 text-[clamp(3.8rem,13vw,6rem)] text-[var(--ink)]"
        style="--d: 0"
      >
        Renzo<br />Campisi
      </h1>
      <p class="hero-in mt-5 mb-0 text-xl font-bold md:text-2xl" style="--d: 1">
        {person.role}
        <span class="block text-[var(--copper-ink)]">{person.focus}</span>
      </p>
      <p class="hero-in mt-4 mb-0 max-w-[34ch] text-lg text-[var(--ink-dim)] md:text-xl" style="--d: 2">
        {person.tagline}
      </p>
      <div class="hero-in mt-8 flex flex-wrap items-center gap-x-5 gap-y-4" style="--d: 3">
        <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
        <a href="#contacto" class="btn btn-line">Contactarme</a>
        <a href={`${base}/${person.cv}`} download={person.cv} class="btn btn-quiet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" />
          </svg>
          Descargar CV
        </a>
      </div>
      <p class="hero-in mt-8 mb-0 flex items-center gap-3 text-[0.98rem] text-[var(--ink-dim)]" style="--d: 4">
        <span class="led" data-status="online" aria-hidden="true"></span>
        Busco mi primer trabajo en desarrollo
      </p>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-[460px]" style="--mask: radial-gradient(circle, #000 52%, transparent 72%)">
      <svg viewBox="0 0 480 480" class="absolute inset-0 h-full w-full [mask-image:var(--mask)]" aria-hidden="true" fill="none">
        <defs>
          <g id="lado">
            {
              pins.map((p, i) => (
                <>
                  <path
                    d={p.path}
                    pathLength="1"
                    stroke={p.live ? 'var(--copper)' : 'var(--trace-off)'}
                    stroke-width={p.live ? 3 : 2.5}
                    stroke-linejoin="round"
                    class={p.live ? 'trace-live' : ''}
                    style={`--i:${i}`}
                  />
                  <rect x="116" y={p.y - 4} width="24" height="8" rx="1" fill="var(--pin)" />
                </>
              ))
            }
          </g>
        </defs>
        {sides.map((r) => <use href="#lado" transform={`rotate(${r} 240 240)`} />)}
        <rect x="140" y="140" width="200" height="200" rx="14" fill="var(--ic-body)" />
        <circle cx="160" cy="160" r="4.5" fill="var(--ic-dim)" />
        <text x="240" y="167" text-anchor="middle" font-family="JetBrains Mono" font-size="10.5" letter-spacing="2" fill="var(--ic-dim)">R.CAMPISI</text>
        <text x="240" y="324" text-anchor="middle" font-family="JetBrains Mono" font-size="10.5" letter-spacing="2" fill="var(--ic-dim)">SISTEMAS</text>
      </svg>
      <div class="absolute overflow-hidden rounded-[10px] border-2 border-[var(--copper)]" style="left: 37.5%; top: 37.5%; width: 25%; height: 25%">
        <Avatar />
      </div>
    </div>
  </div>
</section>
